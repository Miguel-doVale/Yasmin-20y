rules_version = '2';

// Coleção "confirmacoes": só quem confirmou presença (nome + telefone).
// Qualquer visitante pode CRIAR uma confirmação válida; ninguém lê,
// edita ou apaga pelo site. A lista é vista só no Console do Firebase.
service cloud.firestore {
  match /databases/{database}/documents {
    match /confirmacoes/{docId} {
      allow create: if request.resource.data.keys().hasOnly(['nome', 'telefone', 'criadoEm'])
                    && request.resource.data.nome is string
                    && request.resource.data.nome.size() >= 2
                    && request.resource.data.nome.size() <= 80
                    && request.resource.data.telefone is string
                    && request.resource.data.telefone.matches('^[0-9]{10,11}$')
                    && request.resource.data.criadoEm == request.time;
      allow read, update, delete: if false;
    }
  }
}
