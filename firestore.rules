rules_version = '2';

// Regras do Firestore para a coleção "confirmacoes" (RSVP).
// Qualquer pessoa pode CRIAR uma confirmação (é um convite público),
// mas ninguém pode ler, editar ou apagar pelo app — só vocês, pelo
// Console do Firebase, têm acesso de leitura/gestão.
service cloud.firestore {
  match /databases/{database}/documents {
    match /confirmacoes/{docId} {
      allow create: if request.resource.data.keys().hasAll(['nome', 'telefone', 'vaiComparecer', 'criadoEm'])
                    && request.resource.data.nome is string
                    && request.resource.data.nome.size() > 0
                    && request.resource.data.nome.size() < 120
                    && request.resource.data.telefone is string
                    && request.resource.data.telefone.size() > 0
                    && request.resource.data.telefone.size() < 30
                    && request.resource.data.vaiComparecer is bool;
      allow read, update, delete: if false;
    }
  }
}
